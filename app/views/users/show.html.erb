<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info profile-card">
      <div class="profile-icon">
        <%= gravatar_for @user %>
      </div>
      <h1>
        <%= @user.name %>
      </h1>
      <p class="user-introduction">
        <%= @user.introduction %>
      </p>
    </section>
    
    <section class="stats">
      <%= render 'shared/stats' %>
    </section>

    <section class="bookmarked_posts profile-bookmarks">
      <h3>Bookmarked Posts</h3>

      <% if @bookmarked_microposts.any? %>
        <ol class="microposts">
          <%= render @bookmarked_microposts %>
        </ol>
      <% else %>
        <p>No bookmarked posts.</p>
      <% end %>
    </section>
    
  </aside>
    <div class="col-md-8">
      <%= render 'follow_form' if logged_in? %>
      <% if @user.microposts.any? %>
        <div class="posts-heading">
          <h3>
            🍴 Microposts
            <span>(<%= @user.microposts.count %>)</span>
          </h3>
        </div>
        <ol class="microposts">
        <%= render @microposts %>
        </ol>
        <%= will_paginate @microposts %>
      <% end %>
    </div>
</div>
