<div class="password_always_change">
  <div class="password_field" style="position: relative; display: block;">
    <style>
      /*複数のブラウザに対応する*/
      /*Microsoftのパスワード表示ボタン*/
      .password_field input[type="password"]::-ms-reveal,
      .password_field input[type="password"]::-ms-clear {
        display: none; /* デフォルトのボタンを消すために追加 */
      }

      /*Chromeのパスワード表示ボタン*/
      .password_field input[type="password"]::-webkit-credentials-auto-fill-button {
        display: none !important;
        visibility: hidden;
        pointer-events: none;
        position: absolute;/*パスワード入力欄を基準にするため*/
        right: 0;
      }
    </style>

    <%= f.password_field field_name, class: 'form-control', style: 'padding-right: 42px; width: 100%;' %>
    <button type="button" class="toggle_password" aria-label="Toggle password visibility" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); border: none; background: transparent; padding: 0; color: #666; z-index: 2; opacity: 1; visibility: visible; display: inline-block; font-size: 12px; line-height: 1; cursor: pointer;">
      表示
    </button>
  </div>
</div>