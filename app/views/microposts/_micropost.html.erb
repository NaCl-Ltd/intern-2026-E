<!-- 投稿を表示させるファイル -->

<li id="micropost-<%= micropost.id %>">
  <%= link_to gravatar_for(micropost.user, size: 50), micropost.user %>
  <span class="user"><%= link_to micropost.user.name, micropost.user %></span>
  <span class="content">
    <%= micropost.content %>
    <% if micropost.image.attached? %>
      <%= image_tag micropost.image.variant(:display) %>
    <% end %>
  </span>
  <span class="timestamp">
    Posted <%= time_ago_in_words(micropost.created_at) %> ago.

    <!-- いいね数 -->
  <%= turbo_frame_tag "likes_#{micropost.id}" do %> <!-- turbo_frame_tagを使うことで、いいねボタンを押したときにページ全体をリロードせずに、いいね数だけを更新することができる。-->
    <span class="likes">
      <%= pluralize(micropost.likes.count, "like") %>

      <% if logged_in? %>
        <% if current_user.likes.exists?(micropost: micropost) %>
          <%= button_to "♡", micropost_like_path(micropost), method: :delete, class: "btn btn-danger" %>
        <% else %>
          <%= button_to "♡", micropost_like_path(micropost), method: :post, class: "btn btn-outline-danger" %>
        <% end %>
      <% end %>
    </span>
  <% end %>

  <!-- 表示させている投稿がログインユーザーと一致している時の処理（もし自分の投稿だったら） -->
    <% if current_user?(micropost.user) %> 
      <%= link_to "edit", edit_micropost_path(micropost) %>
      |
      <%= link_to "delete", micropost, data: { "turbo-method": :delete,
                                               turbo_confirm: "You sure?" } %>
      <%= link_to micropost.pinned ? "unpin" : "pin",
      pin_micropost_path(micropost),
      data: {
        "turbo-method": :patch,
        turbo_confirm: micropost.pinned ? "Unpin this message?" : "Pin this message?\n*The pinned message will be unpinned"
      } %>
    <% end %>

    <% if !current_user?(micropost.user) %>
      <% bookmarked = current_user.bookmarks.exists?(micropost: micropost) %>

      <%= link_to bookmarked ? "unBM" : "BM",
        bookmark_micropost_path(micropost),
        data: {
          "turbo-method": :patch,
          turbo_confirm: bookmarked ? "UnBookMark this message?" : "BookMark this message?"
          } %>
    <% end %>
  </span>
</li>
