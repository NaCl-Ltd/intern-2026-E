<!-- 投稿を表示させるファイル -->

<li id="micropost-<%= micropost.id %>" class="micropost-card">

  <!-- ユーザー情報 -->
  <div class="micropost-header">

    <%= link_to gravatar_for(micropost.user, size: 50), micropost.user %>

    <div class="micropost-user">
      <span class="user">
        <%= link_to micropost.user.name, micropost.user %>
      </span>

      <span class="timestamp">
        Posted <%= time_ago_in_words(micropost.created_at) %> ago.
      </span>
    </div>

  </div>


  <!-- 投稿内容 -->
  <div class="micropost-content">

    <%= micropost.content %>

    <% if micropost.image.attached? %>
      <%= image_tag micropost.image.variant(:display) %>
    <% end %>
  </span>

  </br>
  
  <span class="shop">
    <% if micropost.shop.present? %>
      shop：
      <%= link_to micropost.shop.name, shop_path(micropost.shop) %>
    <% end %>
  </span>

  <span class="genre">
    <% if micropost.shop.present? %>
      genre：
      <%= micropost.shop.genre %>
    <% end %>
  </span>
    <span class="timestamp">
      Posted <%= time_ago_in_words(micropost.created_at) %> ago.

  </div>


  <!-- いいね -->
  <div class="micropost-likes">

    <%= turbo_frame_tag "likes_#{micropost.id}" do %>

    <span class="likes">
      <%= pluralize(micropost.likes.count, "like") %>

      <% if logged_in? %>

        <% if current_user.likes.exists?(micropost: micropost) %>

          <%= button_to "❤",
            micropost_like_path(micropost),
            method: :delete,
            class: "like-button liked" 
          %>

        <% else %>

         <%= button_to "❤",
            micropost_like_path(micropost),
            method: :post,
          class: "like-button not-liked" 
          %>
        <% end %>
      <% end %>
    </span>
  <% end %>

  </div>


  <!-- 操作ボタン -->
  <div class="micropost-actions">

    <!-- 自分の投稿 -->
    <% if current_user?(micropost.user) %>

      <%= link_to "✏ edit",
        edit_micropost_path(micropost),
        class: "post-action edit-action" 
      %>

      <%= link_to "🗑 delete",
                  micropost,
      data: {
        "turbo-method": :delete,
        turbo_confirm: "You sure?"
      },
      class: "post-action delete-action" %>

      <%= link_to micropost.pinned ? "📍 unpin" : "📌 pin",
        pin_micropost_path(micropost),
        data: {
          "turbo-method": :patch,
          turbo_confirm: micropost.pinned ?
            "Unpin this message?" :
            "Pin this message?\n*The pinned message will be unpinned"
        },
      class: "post-action pin-action" %>
    <% end %>


    <!-- 他人の投稿 -->
    <% if !current_user?(micropost.user) %>

      <% bookmarked = current_user.bookmarks.exists?(micropost: micropost) %>

      <%= link_to bookmarked ? "🔖 unBM" : "🔖 BM",
          bookmark_micropost_path(micropost),
          data: {
            "turbo-method": :patch,
            turbo_confirm: bookmarked ?
              "UnBookMark this message?" :
              "BookMark this message?"
          },
          class: bookmarked ? "bookmark-button bookmarked" : "bookmark-button" %>

    <% end %>

  </div>

</li>